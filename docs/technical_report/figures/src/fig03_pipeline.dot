digraph P {
  graph [rankdir=TB, fontname="Fira Sans", nodesep=0.25, ranksep=0.32, pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Fira Sans", fontsize=9.5, color="#411454", fillcolor="#F4EFFA", width=2.9];
  edge  [color="#5E5566", arrowsize=0.6, fontname="Fira Sans", fontsize=8];
  src   [label="Dataset folder\n(browser, client, CLI or bulk tool)", fillcolor="white"];
  cls   [label="1  Classify files\nskip patterns, file classes (globs),\nparts from sub-folder pattern, time stamps"];
  par   [label="2  Extract parameters\nparameter sources in order:\nJSON/YAML, key-value files, folder name"];
  up    [label="3  Store objects\nkey = datasets/<uuid>/<relative path>\nSHA-256 checksum"];
  meta  [label="4  Register metadata\ndataset, parts, files, quantities,\ntiming, schema hash"];
  proc  [label="5  Process  (ml-api)\ngraph nodes, shared resources,\nparameter vector, SIMILAR_PARAMS edges"];
  emb   [label="6  Field embedding  (on demand)\nincremental PCA of snapshot fields;\nSIMILAR_FIELDS edges", style="rounded,filled,dashed"];
  sch   [label="Project schema", shape=note, fillcolor="#FDE7E8", color="#E20613", width=1.3];
  src -> cls -> par -> up -> meta -> proc;
  proc -> emb [style=dashed, label=" user or API"];
  sch -> cls [style=dashed, color="#E20613", arrowhead=none];
  sch -> par [style=dashed, color="#E20613", arrowhead=none];
  {rank=same; cls; sch}
}
