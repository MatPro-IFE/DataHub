####################################################################
# DataHub - environment template
# Copy to .env (never commit .env) and replace every <CHANGE_ME>.
# Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# The project schema is config/schema.yaml (created from schema.example.yaml by setup-dirs.sh).
####################################################################

# Host directory for PostgreSQL, object store, Neo4j and upload staging
DATA_DIR=./data

# PostgreSQL
POSTGRES_PASSWORD=<CHANGE_ME>

# S3 object store (MinIO)
MINIO_ROOT_USER=datahub-admin
MINIO_ROOT_PASSWORD=<CHANGE_ME>
MINIO_BUCKET=datahub-data
MINIO_BIND=127.0.0.1
# MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:<digest>   # pin for long-lived instances

# Dashboard
DASHBOARD_SECRET_KEY=<CHANGE_ME_at_least_32_chars_long>
# Shared secret between dashboard and ml-api (required)
ML_API_TOKEN=<CHANGE_ME_at_least_32_chars_long>
# true once the dashboard is served over HTTPS: Secure session cookie and HSTS
DATAHUB_COOKIE_SECURE=false
# Limits: minimum password length, size of one upload (GB)
DATAHUB_MIN_PASSWORD_LENGTH=12
DATAHUB_MAX_UPLOAD_GB=200
DATAHUB_ADMIN_PASSWORD=<CHANGE_ME>
DASHBOARD_BIND=127.0.0.1
DASHBOARD_TZ=UTC
# DATAHUB_SITE_NAME=        # defaults to instance.name in the schema

# Organisation-based access control (optional)
DATAHUB_ORGANIZATIONS=OrgA,OrgB,OrgC
DATAHUB_ORG_EMAIL_DOMAINS=orga.example=OrgA,orgb.example=OrgB
# file classes (schema ids) an organisation may never see, '|' separated, e.g. OrgC=input|mesh
DATAHUB_ORG_HIDDEN_FILE_CLASSES=

# Time-limited sharing links: longest allowed lifetime in days (0 disables links).
DATAHUB_SHARE_MAX_DAYS=30
# Public address of the dashboard used in sharing links, e.g. https://datahub.example.org
# (default: the address the request came in on)
# DATAHUB_PUBLIC_URL=

# Neo4j
NEO4J_PASSWORD=<CHANGE_ME>
NEO4J_HEAP=1g

# Optional read-only folder for server-side bulk ingestion
# INGEST_FOLDER=/path/to/runs

# Optional admin profile (PostgREST, Studio): JWT secret for PostgREST
# PGRST_JWT_SECRET=<at least 32 chars>
